import sqlite3
from database import create_connection, create_tables
from models import Employee, Shift, Attendance

create_tables()

def add_employee(name, status, department):
    conn = create_connection()
    cursor = conn.cursor()
    cursor.execute('''
        INSERT INTO employees (name, status, department)
        VALUES (?, ?, ?)
    ''', (name, status, department))
    conn.commit()
    conn.close()

def add_shift(employee_id, shift_date, start_time, end_time):
    conn = create_connection()
    cursor = conn.cursor()
    cursor.execute('''
        INSERT INTO shifts (employee_id, shift_date, start_time, end_time)
        VALUES (?, ?, ?, ?)
    ''', (employee_id, shift_date, start_time, end_time))
    conn.commit()
    conn.close()

def add_attendance(employee_id, shift_id, check_in_time):
    conn = create_connection()
    cursor = conn.cursor()
    cursor.execute('''
        INSERT INTO attendance (employee_id, shift_id, check_in_time)
        VALUES (?, ?, ?)
    ''', (employee_id, shift_id, check_in_time))
    conn.commit()
    conn.close()

def get_open_shifts():
    conn = create_connection()
    cursor = conn.cursor()
    cursor.execute('''
        SELECT e.name, s.shift_date, s.start_time, s.end_time
        FROM shifts s
        JOIN employees e ON s.employee_id = e.id
        WHERE s.shift_date >= DATE('now')
    ''')
    shifts = cursor.fetchall()
    conn.close()
    return shifts

if __name__ == "__main__":
    add_employee('Иван Иванов', 'Основной', 1)
    add_employee('Мария Петрова', 'Сезонный', 2)
    add_shift(1, '2025-02-10', '09:00', '18:00')
    add_shift(2, '2025-02-10', '10:00', '19:00')
    open_shifts = get_open_shifts()
    for shift in open_shifts:
        print(f"Сотрудник: {shift[0]}, Дата смены: {shift[1]}, Время: {shift[2]} - {shift[3]}")
